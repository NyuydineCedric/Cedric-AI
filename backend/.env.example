# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored so real secrets never get committed.

# Required starting Phase 3 (chat) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - defaults to gemini-flash-latest if unset.
GEMINI_MODEL=

# Not used yet - will matter starting Phase 6 (embeddings/vector DB)
# and beyond, once we introduce PostgreSQL + pgvector.
# Until then, the backend defaults to a local SQLite file if this is left blank.
DATABASE_URL=

# Phase 2 (auth): secret used to sign/verify JWTs. Required - the app
# will refuse to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse a demo/example value in a real deployment.
JWT_SECRET_KEY=
